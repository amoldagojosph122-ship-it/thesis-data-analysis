    "primary_weighting": "INTERVAL",
    "secondary_weighting": "EQUAL_HOLE",
    "unit_of_analysis": "logged interval; fold unit HELD_OUT_LINE; uncertainty resampled by hole (primary) and line (sensitivity)"
  },
