  "plan": {
    "bootstrap_design": "HOLE_CLUSTER primary; LINE_CLUSTER sensitivity",
    "calibration_policy": "O3 calibration only; O4 fits diagnostics and never recalibrates",
    "cohort_definition": "intersection of the full-coverage feasible models on the held-out folds",
    "decision_policy_json": "{\"comparator\": \"NEXT_LOWEST_POOLED_INTERVAL_BRIER\", \"improvement_rule\": \"SUPPORTED_IMPROVEMENT requires all of: the 95% hole-cluster bootstrap interval of (Brier_selected - Brier_comparator) lies entirely below zero; the selected model has the lower Brier in at least four of the five folds; the calibration slope is in [0.5, 2.0] and |intercept| <= 0.5; the selected model's ROC-AUC is not worse than the comparator's by more than 0.02; and coverage is at least 0.95. INCONCLUSIVE applies when the interval includes zero or fold consistency is below four of five. NO_IMPROVEMENT applies when the point estimate is non-negative or the interval lies entirely above zero. NOT_COMPARABLE applies to a model with coverage below 0.95, a missing metric, or an identity with another model.\\n\", \"select\": \"LOWEST_POOLED_INTERVAL_BRIER_AMONG_DISTINCT_FULL_COVERAGE_MODELS\", \"selection_basis_when_inconclusive\": \"POINT_ESTIMATE_WITH_CAVEAT\"}",
    "frozen_utc": "2026-11-06T04:56:21Z",
    "plan_id": "O4-CFG-2026.11.06-2-PLAN",
